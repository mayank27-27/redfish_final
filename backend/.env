# =============================================================================
# Redfish Fleet Monitor — Environment Configuration
# =============================================================================
# This file is loaded by python-dotenv at startup AND by Docker Compose.
# Edit this file with your real values, then restart the application.
#
# NEVER commit this file to version control if it contains real credentials.
# =============================================================================

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=development

# Random 32-byte hex secret. Keep this consistent across restarts.
SECRET_KEY=0f622cc02562f6b95dbae1b714ef258515967c3f24fc83bbc29851f5d31369dc

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# When running inside Docker Compose, the hostname is "db" (the service name).
# When running locally (python app.py), use "localhost".
DATABASE_URL=postgresql://redfish:redfish@db:5432/redfishmonitor

# ── Credential Encryption ─────────────────────────────────────────────────
# A SINGLE Fernet key — exactly 44 URL-safe base64 characters ending in "=".
# Generate a fresh key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# WARNING: If you change this key, all stored BMC passwords become unreadable.
# You must re-add every server after changing this key.
ENCRYPTION_KEY=4XXHGsS0XyQRzqF9kOeYhUq2R2aSxBQMIPd2qyzr3EA=

# ── Redfish HTTP client ────────────────────────────────────────────────────
# false = accept self-signed BMC TLS certificates (required for most lab BMCs)
REDFISH_VERIFY_TLS=false
REDFISH_HTTP_TIMEOUT=30
REDFISH_MAX_RETRIES=3
REDFISH_RETRY_BACKOFF_SECONDS=2

# ── Polling ────────────────────────────────────────────────────────────────
DEFAULT_POLLING_INTERVAL_SECONDS=30
MAX_CONCURRENT_POLLS=50
INVENTORY_REFRESH_INTERVAL_SECONDS=900

# ── Dell TSR (CIFS Export) ────────────────────────────────────────────────
# Windows SMB share used by iDRAC to write Tech Support Reports.
# This folder is bind-mounted into the Docker container at /mnt/tsr.
DELL_TSR_CIFS_IP_ADDRESS=192.168.3.172
DELL_TSR_CIFS_SHARE_NAME=TSR_share
DELL_TSR_CIFS_USERNAME=janha
DELL_TSR_CIFS_PASSWORD=wdw1d4ever
DELL_TSR_STORAGE_PATH=/mnt/tsr
DELL_TSR_DATA_SELECTORS=HWData


# ── Alert thresholds ───────────────────────────────────────────────────────
FALLBACK_TEMPERATURE_CRITICAL_C=85

# ── Sensor history ─────────────────────────────────────────────────────────
SENSOR_HISTORY_RETENTION_DAYS=30

# ── Redfish EventService push subscriptions ───────────────────────────────
# Leave blank to disable (polling-only mode, recommended for most setups).
PUBLIC_WEBHOOK_BASE_URL=

# ── SocketIO ───────────────────────────────────────────────────────────────
SOCKETIO_ASYNC_MODE=eventlet

HOST=0.0.0.0
PORT=5000
DEBUG=false

# ── Agent Enrollment ───────────────────────────────────────────────────────
ENROLLMENT_KEY_HASH=b64354bbc8510bd9acc443468d21c6a72dce1231e70f58bd1e1785c301ef875a
