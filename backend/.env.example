# =============================================================================
# Redfish Fleet Monitor — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# The .env file is loaded automatically by python-dotenv at startup.
#
# NEVER commit the actual .env file to version control.
# =============================================================================

# ── Flask ──────────────────────────────────────────────────────────────────
FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# ── PostgreSQL ─────────────────────────────────────────────────────────────
# Local dev (matches docker-compose.yml defaults):
DATABASE_URL=postgresql://redfish:redfish@localhost:5432/redfishmonitor
# Production example (Render / Railway / Supabase):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Credential Encryption ─────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production — leave blank in dev only (auto-generates a temporary key with a warning)
ENCRYPTION_KEY=

# ── Redfish HTTP client ────────────────────────────────────────────────────
# Set to false for lab BMCs with self-signed certificates
REDFISH_VERIFY_TLS=false
REDFISH_HTTP_TIMEOUT=30
REDFISH_MAX_RETRIES=3
REDFISH_RETRY_BACKOFF_SECONDS=2

# ── Polling ────────────────────────────────────────────────────────────────
DEFAULT_POLLING_INTERVAL_SECONDS=30
MAX_CONCURRENT_POLLS=50
INVENTORY_REFRESH_INTERVAL_SECONDS=900

# Dell TSR CIFS export
# The app container mounts C:\TSRShare at /mnt/tsr (see docker-compose.yml).
DELL_TSR_CIFS_IP_ADDRESS=192.168.3.172
DELL_TSR_CIFS_SHARE_NAME=TSR_share
DELL_TSR_CIFS_USERNAME=janha
DELL_TSR_CIFS_PASSWORD=<WINDOWS_PASSWORD>
DELL_TSR_STORAGE_PATH=/mnt/tsr
DELL_TSR_DATA_SELECTORS=HWData

# ── Alert thresholds ───────────────────────────────────────────────────────
FALLBACK_TEMPERATURE_CRITICAL_C=85

# ── Sensor history ─────────────────────────────────────────────────────────
SENSOR_HISTORY_RETENTION_DAYS=30

# ── Redfish EventService push subscriptions ───────────────────────────────
# Set to the public URL of this app so BMCs can push events to us.
# Leave blank to disable event subscriptions (polling-only mode).
PUBLIC_WEBHOOK_BASE_URL=

# ── SocketIO ───────────────────────────────────────────────────────────────
SOCKETIO_ASYNC_MODE=eventlet
# Optional Redis URL for multi-process deployments:
# SOCKETIO_MESSAGE_QUEUE=redis://localhost:6379/0

# ── Agent Enrollment ──────────────────────────────────────────────────────
# SHA-256 hash of the enrollment key that remote agents use to self-register.
# Generate a key:   python -c "import secrets; print(secrets.token_hex(32))"
# Generate hash:    python -c "import hashlib, sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())" YOUR_KEY
# Share the raw key with customers. Store ONLY the hash here.
ENROLLMENT_KEY_HASH=

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
DEBUG=true
